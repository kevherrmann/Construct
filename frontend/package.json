{
  "name": "construct-frontend",
  "private": true,
  "version": "5.4.0",
  "type": "module",
  "description": "CONSTRUCT web interface (React). Built into ../static/app — see README.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "format:check": "prettier --check src",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "dependencies": {
